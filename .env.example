# Copy to .env (same directory) and fill in. .env is gitignored — never commit it.
# Loaded automatically by `npm start` via node --env-file-if-exists=.env
#
# EVERY VALUE BELOW IS A PLACEHOLDER. This file is committed, so it holds no real
# keys — copying it and running as-is does NOT give you a working app. Replace
# each one or delete the line; a half-filled .env fails in ways that look like
# bugs (see ANTHROPIC_API_KEY below).
#
# On DigitalOcean this file is NOT used: set these in the App Platform dashboard
# (App > Settings > web > Environment Variables) and mark ANTHROPIC_API_KEY as SECRET.

# --- AI features (Claude). ---
# Get a key at console.anthropic.com > API keys.
#
# UNSET and WRONG are different failures, and the wrong one is worse:
#   unset          -> AI endpoints return ai_not_configured (503), the buttons
#                     say "not configured", nothing else changes.
#   set but wrong  -> AI advertises itself and EVERY call fails with
#                     ai_key_rejected (502), mid-session.
# Leaving the literal `sk-ant-...` below in place is the second case. The server
# prints a loud boot warning when the key does not look real. If you are not
# using AI, delete the line rather than leaving the placeholder.
ANTHROPIC_API_KEY=sk-ant-...

# Live, latency-sensitive features (Q&A clustering, synthesis, poll drafting).
ANTHROPIC_MODEL=claude-haiku-4-5
# Handwriting OCR and worksheet analysis — quality matters more than latency here.
ANTHROPIC_MODEL_OCR=claude-sonnet-5
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5

# --- Durable store. Unset => in-memory only. ---
# Both must be set or persistence is off entirely — and in-memory mode costs more
# than persistence: CSV export, the AI debrief and the cross-event dashboard all
# read back through Supabase and go dead without it. See README > In-memory mode.
#
# Real values: Supabase dashboard > Project Settings > API (project URL +
# publishable key). The deployed project's values are pinned in .do/app.yaml.
#
# SUPABASE_KEY is the publishable key, not the service-role key. Publishable is
# the key meant to be handed out — but that is only safe if row-level security is
# enabled on every table. Nothing here verifies that. Never put a service-role
# key in this file or in .do/app.yaml.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_...

# --- Optional tuning (defaults shown). ---
# PORT=3000
# AI_CONCURRENCY_OCR=10          # parallel OCR calls; raise on a higher API tier
# AI_CONCURRENCY_INTERACTIVE=2
# AI_QUEUE_MAX=120               # queued photo jobs before shedding with 503.
#                                # Each holds one decoded image until its call
#                                # runs — OCR_B64_MAX caps that at ~880 KB, and
#                                # the measured resident cost is ~1.5 MB per job
#                                # (decode garbage and unreturned heap on top).
#                                # 10 running + 120 queued measured ~245 MB RSS;
#                                # the sizing argument is in .do/app.yaml.
# AI_TIMEOUT_MS=60000
